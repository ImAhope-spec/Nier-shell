+// NieR: прямоугольник со срезанными углами (угол 45 градусов): tl, tr, bl, br - размер среза в физических px.
+// Рисуем горизонтальными полосками по 1 px: на каждой строке срез сокращается на 1 px. На самой диагонали
+// добавляем пиксель с половинной прозрачностью: для 45 градусов это точное сглаживание.
+// Используются только те же вызовы renderRect, что и у оригинального плагина.
+static void renderBeveledBox(const CBox& box, const CHyprColor& color, int tl, int tr, int bl, int br, bool blur, float a) {
+    const double x = box.x, y = box.y, w = box.w, h = box.h;
+    const int    maxB = (int)(std::min(w, h) / 2.0);
+    tl = std::clamp(tl, 0, maxB);
+    tr = std::clamp(tr, 0, maxB);
+    bl = std::clamp(bl, 0, maxB);
+    br = std::clamp(br, 0, maxB);
+
+    CHyprColor edge = color;
+    edge.a *= 0.5F;
+
+    auto fill = [&](const CBox& b, const CHyprColor& c, bool useBlur) {
+        if (b.w < 1 || b.h < 1)
+            return;
+        if (useBlur)
+            g_pHyprOpenGL->renderRect(b, c, {.round = 0, .roundingPower = 2.F, .blur = true, .blurA = a});
+        else
+            g_pHyprOpenGL->renderRect(b, c, {});
+    };
+
+    const int top    = std::max(tl, tr);
+    const int bottom = std::max(bl, br);
+
+    for (int r = 0; r < top; ++r) {
+        const double il = tl > r ? tl - r : 0;
+        const double ir = tr > r ? tr - r : 0;
+        fill({x + il, y + r, w - il - ir, 1.0}, color, blur);
+        if (il > 0)
+            fill({x + il - 1.0, y + r, 1.0, 1.0}, edge, false);
+        if (ir > 0)
+            fill({x + w - ir, y + r, 1.0, 1.0}, edge, false);
+    }
+
+    for (int r = 0; r < bottom; ++r) {
+        const double il = bl > r ? bl - r : 0;
+        const double ir = br > r ? br - r : 0;
+        const double ry = y + h - 1.0 - r;
+        fill({x + il, ry, w - il - ir, 1.0}, color, blur);
+        if (il > 0)
+            fill({x + il - 1.0, ry, 1.0, 1.0}, edge, false);
+        if (ir > 0)
+            fill({x + w - ir, ry, 1.0, 1.0}, edge, false);
+    }
+
+    fill({x, y + top, w, h - top - bottom}, color, blur);
+}
